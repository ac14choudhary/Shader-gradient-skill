{
  "name": "beautiful-shader",
  "version": "0.1.0",
  "description": "Typed WebGL gradient shader recipes, presets, and LLM prompt helpers from the Beautiful Shader Atlas.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18 || >=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
